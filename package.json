{
  "name": "dona-v3",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src evals",
    "format": "biome format --write src evals",
    "db:up": "docker compose up -d",
    "dev": "node src/dev.ts",
    "import": "node src/import.ts",
    "guidance": "node --env-file-if-exists=.env.example --env-file-if-exists=.env src/guidance.ts",
    "reset": "node src/reset-data.ts",
    "start": "node src/serve.ts",
    "evals": "node --env-file-if-exists=.env evals/run.ts",
    "measure": "node --env-file-if-exists=.env evals/measure.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "fastify": "^5.12.1",
    "google-auth-library": "^11.0.2",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0"
  }
}
