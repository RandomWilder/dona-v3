# Local defaults — copy to .env to override. Real secrets never live in the repo.
DATABASE_URL=postgres://dona:dona@127.0.0.1:5434/dona
PORT=3000

# Staff login. Both must be set together or boot fails; both unset means no
# seeding at all. Left commented so a committed default can never become a
# way into a real environment — set them in .env (gitignored) for local work.
# In staging and prod they come from Secret Manager.
# STAFF_SEED_EMAIL=dev@dona.local
# STAFF_SEED_PASSWORD=<at least 12 characters, your own>
